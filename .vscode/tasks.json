{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build microcontroller-embedded-c-programming",
      "type": "shell",
      "command": "make build",
      "options": { "cwd": "${workspaceFolder}/stm32/microcontroller-embedded-c-programming" },
      "group": "build",
      "problemMatcher": ["$gcc"]
