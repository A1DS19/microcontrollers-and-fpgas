    {
      "label": "build embedded-system-programming-on-arm-cortex-m3m4",
      "type": "shell",
      "command": "make build",
      "options": { "cwd": "${workspaceFolder}/stm32/embedded-system-programming-on-arm-cortex-m3m4" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
